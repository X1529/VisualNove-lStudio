  "dialogues": [
    {
      "dialogue_id": 1,
      "sort_order": 0,
      "title": "",
      "pos_x": 138,
      "pos_y": 42,
      "lines": [
        {
          "speaker": "left",
          "name": "ดันเต้",
          "identity": "ผู้จัดการ",
          "text": "(ดอน กิโฆเต้ ช่วยอยู่นิ่งๆ สักพักได้ไหม?)",
          "bg": 9,
          "bgm": 14,
          "sfx": 24,
          "characters": [
            {
              "asset_id": 8,
              "position": "left",
              "highlight": true
            },
            {
              "asset_id": 11,
              "position": "right",
              "highlight": false
            }
          ],
          "flash": false,
          "flashDuration": 400,
          "shake": false,
          "shakeType": "shake-horizontal",
          "shakeDuration": 300,
          "hideUi": false,
          "hideUiElements": [],
          "showUiElements": []
        },
        {
          "speaker": "right",
          "name": "ดอน กิโฆเต้",
          "identity": "คนบาป หมายเลข 3",
          "text": "ฮ่าฮ่า! ท่านผู้จัดการ! ข้ากำลังฝึกฝนวิชาดาบแห่งความยุติธรรมอยู่นะขอรับ!",
          "bg": 9,
          "bgm": 14,
          "sfx": 26,
          "characters": [
            {
              "asset_id": 8,
              "position": "left",
              "highlight": false
            },
            {
              "asset_id": 11,
              "position": "right",
              "highlight": true
            }
          ],
          "flash": false,
          "flashDuration": 400,
          "shake": false,
          "shakeType": "shake-horizontal",
          "shakeDuration": 300,
          "hideUi": false,
          "hideUiElements": [],
          "showUiElements": []
        },
        {
          "speaker": "left",
          "name": "ดันเต้",
          "identity": "ผู้จัดการ",
          "text": "(แต่ควงดาบในรถบัสแบบนี้มันอันตรายนะ!)",
          "bg": 9,
          "bgm": 14,
          "sfx": 19,
          "characters": [
            {
              "asset_id": 8,
              "position": "left",
              "highlight": true
            },
            {
              "asset_id": 12,
              "position": "right",
              "highlight": false
            }
          ],
          "flash": false,
          "flashDuration": 400,
          "shake": false,
          "shakeType": "shake-horizontal",
          "shakeDuration": 300,
          "hideUi": false,
          "hideUiElements": [],
          "showUiElements": []
        },
        {
          "speaker": "right",
          "name": "ดอน กิโฆเต้",
          "identity": "คนบาป หมายเลข 3",
          "text": "ไม่ต้องห่วงขอรับ! ฝีมือของข้าเฉียบคมระระดับตำนาน— ย๊ากกก!",
          "bg": 9,
          "bgm": 14,
          "sfx": 21,
          "characters": [
            {
              "asset_id": 8,
              "position": "left",
              "highlight": false
            },
            {
              "asset_id": 10,
              "position": "right",
              "highlight": true
            }
          ],
          "flash": true,
          "flashDuration": 400,
          "shake": true,
          "shakeType": "shake-horizontal",
          "shakeDuration": 400,
          "hideUi": false,
          "hideUiElements": [],
          "showUiElements": []
        },
        {
          "speaker": "left",
          "name": "ดันเต้",
          "identity": "ผู้จัดการ",
          "text": "(โอ๊ย! โดนหัวฉันเต็มๆ เลยเห็นไหม!)",
          "bg": 9,
          "bgm": 14,
          "sfx": 20,
          "characters": [
            {
              "asset_id": 8,
              "position": "left",
              "highlight": true
            },
            {
              "asset_id": 10,
              "position": "right",
              "highlight": false
            }
          ],
          "flash": true,
          "flashDuration": 0.2,
          "shake": true,
          "shakeType": "shake-heavy",
          "shakeDuration": 0.5,
          "hideUi": false,
          "hideUiElements": [],
          "showUiElements": []
        },
        {
          "speaker": "right",
          "name": "ดอน กิโฆเต้",
          "identity": "คนบาป หมายเลข 3",
          "text": "หวาาา! ท่านผู้จัดการ! ข้าขออภัยอย่างยิ่งยวดขอรับ!",
          "bg": 9,
          "bgm": 14,
          "sfx": null,
          "characters": [
            {
              "asset_id": 8,
              "position": "left",
              "highlight": false
            },
            {
              "asset_id": 10,
              "position": "right",
              "highlight": true
            }
          ],
          "flash": false,
          "flashDuration": 400,
          "shake": false,
          "shakeType": "shake-horizontal",
          "shakeDuration": 300,
          "hideUi": false,
          "hideUiElements": [],
          "showUiElements": []
        },
        {
          "speaker": "left",
          "name": "ดันเต้",
          "identity": "ผู้จัดการ",
          "text": "... คราวหลังให้ไปซ้อมข้างนอกรถนะ...",
          "bg": 9,
          "bgm": 14,
          "sfx": 22,
          "characters": [
            {
              "asset_id": 8,
              "position": "left",
              "highlight": true
            },
            {
