  "dialogues": [
    {
      "dialogue_id": 1,
      "sort_order": 0,
      "title": "",
      "pos_x": 90.85408323777597,
      "pos_y": 31.546526577446464,
      "lines": [
        {
          "speaker": "center",
          "name": "???",
          "identity": "",
          "text": "สวัสดีคะ...ฉันชื่อว่าAmiya มาเป็นผู้แทนการนำเสนอโปรเจกต์",
          "bg": 49,
          "bgm": 14,
          "sfx": null,
          "characters": [
            {
              "asset_id": 53,
              "position": "right",
              "highlight": true
            }
          ],
          "flash": false,
          "flashDuration": 400,
          "shake": false,
          "shakeType": "shake-horizontal",
          "shakeDuration": 300,
          "hideUi": false,
          "hideUiElements": [],
          "showUiElements": []
        },
        {
          "speaker": "center",
          "name": "Amiya",
          "identity": "",
          "text": "โปรเจกต์มีชื่อว่า Visual Novel Studio",
          "bg": 49,
          "bgm": null,
          "sfx": 48,
          "characters": [
            {
              "asset_id": 52,
              "position": "right",
              "highlight": true
            }
          ],
          "flash": false,
          "flashDuration": 400,
          "shake": false,
          "shakeType": "shake-horizontal",
          "shakeDuration": 300,
          "hideUi": false,
          "hideUiElements": [],
          "showUiElements": []
        }
      ],
      "nextChapter": null,
      "choices": [
        {
          "text": "ทำไมถึงสร้าง Visual Novel Studio ขึ้นมา",
          "next": 2
        },
        {
          "text": "Visual Novel คืออะไร",
          "next": null
        }
      ]
    },
    {
      "dialogue_id": 2,
      "sort_order": 1,
      "title": "",
      "pos_x": 511.0648434506436,
      "pos_y": 43.819329279800385,
      "lines": [
        {
          "speaker": "center",
          "name": "Amiya",
          "identity": "",
          "text": "ปัญหาคือ “เราอยากแต่งเรื่องสักเรื่อง…”",
          "bg": 49,
          "bgm": 47,
          "sfx": 48,
          "characters": [
            {
              "asset_id": 42,
              "position": "right",
              "highlight": true
            }
          ],
          "flash": false,
          "flashDuration": 400,
          "shake": false,
          "shakeType": "shake-horizontal",
          "shakeDuration": 300,
          "hideUi": false,
          "hideUiElements": [],
          "showUiElements": []
        },
        {
          "speaker": "center",
          "name": "Amiya",
          "identity": "",
          "text": "“แต่เราไม่ค่อยชอบนิยายที่มีแต่อักษร\nเราชอบการเล่าเรื่องแบบ Webtoon มากกว่า\nเพราะมีทั้งภาพ ตัวละคร และบทสนทนา ทำให้เห็นเรื่องราวได้ง่ายกว่า”\n",
          "bg": 50,
          "bgm": null,
          "sfx": 48,
          "characters": [
            {
              "asset_id": 54,
              "position": "right",
              "highlight": true
            }
          ],
          "flash": false,
          "flashDuration": 400,
          "shake": false,
          "shakeType": "shake-horizontal",
          "shakeDuration": 300,
          "hideUi": false,
          "hideUiElements": [],
          "showUiElements": []
        },
        {
          "speaker": "center",
          "name": "Amiya",
          "identity": "",
          "text": "ไม่ได้ถนัดด้านการวาดภาพ\nการสร้างตัวละครและฉากเองจึงเป็นเรื่องที่ค่อนข้างยาก ต้องวาดตัวละครหลายท่าทาง หลายมุม และหลายอารมณ์\nซึ่งใช้เวลาและฝีมือค่อนข้างมา ",
          "bg": 51,
          "bgm": null,
          "sfx": 48,
          "characters": [
            {
              "asset_id": 52,
              "position": "right",
              "highlight": true
            }
          ],
          "flash": false,
          "flashDuration": 400,
          "shake": false,
          "shakeType": "shake-horizontal",
          "shakeDuration": 300,
          "hideUi": false,
          "hideUiElements": [],
          "showUiElements": []
        },
        {
          "speaker": "center",
          "name": "Amiya",
          "identity": "",
          "text": "อย่างน้อยก็วาดตัวละครแบบหน้าตรงได้ อย่างตัวฉันเองเป็นตัวละครแบบหน้าตรง",
          "bg": 49,
          "bgm": null,
          "sfx": 48,
          "characters": [
            {
              "asset_id": 42,
              "position": "right",
              "highlight": true
            }
          ],
          "flash": false,
          "flashDuration": 400,
          "shake": false,
          "shakeType": "shake-horizontal",
          "shakeDuration": 300,
          "hideUi": false,
          "hideUiElements": [],
          "showUiElements": []
        }
      ],
      "nextChapter": null,
      "choices": [
        {
          "text": "จึงเลือก Visual Novel…ใช่ไหม",
          "next": 3
        }
      ]
    },
    {
      "dialogue_id": 3,
      "sort_order": 2,
      "title": "",
      "pos_x": 832.6496720603625,
      "pos_y": 35.33931443887576,
      "lines": [
        {
          "speaker": "center",
          "name": "Amiya",
          "identity": "",
          "text": "ใช่แล้ว เพราะ Visual Novel สามารถวาดตัวละครขึ้นมาเพียงครั้งเดียว แล้วนำตัวละครเดิมมาเปลี่ยนสีหน้า หรือ Expression ได้ ทำให้เราไม่จำเป็นต้องวาดตัวละครใหม่ทุกครั้งที่เปลี่ยนฉากหรือบทสนทนา",
          "bg": 49,
          "bgm": 47,
          "sfx": 48,
          "characters": [
            {
              "asset_id": 52,
              "position": "right",
              "highlight": true
            }
          ],
          "flash": false,
          "flashDuration": 400,
          "shake": false,
          "shakeType": "shake-horizontal",
          "shakeDuration": 300,
          "hideUi": false,
          "hideUiElements": [],
          "showUiElements": []
        }
      ],
      "nextChapter": null,
      "choices": [
        {
          "text": "แล้วถ้าเราอยากสร้าง Visual Novel ขึ้นมาจริง ๆ ล่ะ?",
          "next": 5
        }
      ]
    },
    {
      "dialogue_id": 4,
      "sort_order": 3,
      "title": "",
      "pos_x": 1505.4208077450123,
      "pos_y": 115.77216114671614,
      "lines": [
        {
          "speaker": "center",
          "name": "Amiya",
          "identity": "",
          "text": "“Game Engine มีความสามารถมากและเหมาะกับการพัฒนาเกมเต็มรูปแบบ แต่สำหรับผู้ที่ต้องการเน้นการเขียนเรื่อง บทสนทนา และเส้นทางของเรื่อง อาจมีระบบที่ไม่จำเป็นต้องใช้งาน”",
          "bg": 49,
          "bgm": 14,
          "sfx": 48,
          "characters": [
            {
              "asset_id": 54,
              "position": "right",
              "highlight": true
            }
          ],
          "flash": false,
          "flashDuration": 400,
          "shake": false,
          "shakeType": "shake-horizontal",
          "shakeDuration": 300,
          "hideUi": false,
          "hideUiElements": [],
          "showUiElements": [
            "dialogueLine",
            "speakerName",
            "dialogueText"
          ]
        },
        {
          "speaker": "center",
          "name": "Amiya",
          "identity": "",
          "text": "เราเลยเลือกสร้าง Visual Novel Studio ที่ตัดความซับซ้อนเหล่านั้นออก และเน้นเฉพาะกระบวนการสร้าง Visual Novel",
          "bg": 49,
          "bgm": null,
          "sfx": null,
          "characters": [
            {
              "asset_id": 53,
              "position": "right",
              "highlight": true
            }
          ],
          "flash": false,
          "flashDuration": 400,
          "shake": false,
          "shakeType": "shake-horizontal",
          "shakeDuration": 300,
          "hideUi": false,
          "hideUiElements": [],
          "showUiElements": [
            "dialogueLine",
            "speakerName",
            "dialogueText"
          ]
        }
      ],
      "nextChapter": null,
      "choices": [
        {
          "text": "แล้วสิ่งที่เราพูดมาทั้งหมดนี้ เอาไปใช้งานจริงอย่างไร?",
          "next": 6
        }
      ]
    },
    {
      "dialogue_id": 5,
      "sort_order": 4,
      "title": "",
      "pos_x": 1151.3899984885604,
      "pos_y": 66.22124859510188,
      "lines": [
        {
          "speaker": "center",
          "name": "Amiya",
          "identity": "",
          "text": "จึงสร้างเครื่องมือที่เน้นการสร้าง Visual Novel โดยเฉพาะ และสามารถจัดการทุกอย่างผ่านเว็บไซต์ได้",
          "bg": 49,
          "bgm": null,
          "sfx": 48,
          "characters": [
            {
              "asset_id": 53,
              "position": "right",
              "highlight": true
            }
          ],
          "flash": false,
          "flashDuration": 400,
          "shake": false,
          "shakeType": "shake-horizontal",
          "shakeDuration": 300,
          "hideUi": false,
          "hideUiElements": [],
          "showUiElements": []
        }
      ],
      "nextChapter": null,
      "choices": [
        {
          "text": "ทำไมไม่ใช้ Engine?",
          "next": 4
        }
      ]
    },
    {
      "dialogue_id": 6,
      "sort_order": 5,
      "title": "",
      "pos_x": 1946.8813866347834,
      "pos_y": 121.30116100027419,
      "lines": [
