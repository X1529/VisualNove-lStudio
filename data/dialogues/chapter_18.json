  "dialogues": [
    {
      "dialogue_id": 1,
      "sort_order": 0,
      "title": "",
      "pos_x": 40,
      "pos_y": 40,
      "lines": [
        {
          "speaker": "center",
          "name": "",
          "identity": "",
          "text": "แสงยามเย็นสีส้มอมแดงส่องลอดหน้าต่างรถบัสเมฟิสโตเฟเลส ตกกระทบคราบเลือดแห้งเกรอะกรังบนพื้นไม้และเบาะนั่ง เสียงเครื่องยนต์ด้านล่างส่งเสียงบดขยี้ชิ้นส่วนเนื้อและกระดูกเป็นจังหวะหนักแน่น",
          "bg": 38,
          "bgm": 14,
          "sfx": null,
          "characters": [],
          "flash": false,
          "flashDuration": 400,
          "shake": false,
          "shakeType": "shake-horizontal",
          "shakeDuration": 300,
          "hideUi": false
        },
        {
          "speaker": "center",
          "name": "Dante",
          "identity": "Manager",
          "text": "<Tick-Tock> (งานสำหรับวันนี้สิ้นสุดลงแล้ว ขอให้ทุกคนพักผ่อนตามอัธยาศัย)",
          "bg": 38,
          "bgm": 14,
          "sfx": 16,
          "characters": [
            {
              "asset_id": 8,
              "position": "center",
              "highlight": true
            }
          ],
          "flash": false,
          "flashDuration": 400,
          "shake": false,
          "shakeType": "shake-horizontal",
          "shakeDuration": 300,
          "hideUi": false
        },
        {
          "speaker": "left",
          "name": "Don Quixote",
          "identity": "Sinner #3",
          "text": "โอ้! ท่านผู้จัดการเอสไควร์! ภารกิจปราบอธรรมประจำวันอันทรงเกียรติเสร็จสิ้นลงแล้วหรือนี่!",
          "bg": 38,
          "bgm": 14,
          "sfx": 26,
          "characters": [
            {
              "asset_id": 11,
              "position": "left",
              "highlight": true
            }
          ],
          "flash": false,
          "flashDuration": 400,
          "shake": true,
          "shakeType": "shake-vertical",
          "shakeDuration": 0.3,
          "hideUi": false
        },
        {
          "speaker": "right",
          "name": "Ryōshū",
          "identity": "Sinner #4",
          "text": "ช.ล.ก. ... เช็ดเลือดก่อน",
          "bg": 38,
          "bgm": 14,
          "sfx": null,
          "characters": [
            {
              "asset_id": 36,
              "position": "right",
              "highlight": true
            }
          ],
          "flash": false,
          "flashDuration": 400,
          "shake": false,
          "shakeType": "shake-horizontal",
          "shakeDuration": 300,
          "hideUi": false
        },
        {
          "speaker": "right",
          "name": "Hong Lu",
          "identity": "Sinner #8",
          "text": "วันนี้ก็เป็นวันที่ราบรื่นอีกวันนะครับ ถ้วยชานี้ยังมีกลิ่นหอมชวนผ่อนคลายเหมือนเคยเลยครับ",
          "bg": 38,
          "bgm": 14,
          "sfx": null,
          "characters": [
            {
              "asset_id": 32,
              "position": "right",
              "highlight": true
            }
          ],
          "flash": false,
          "flashDuration": 400,
          "shake": false,
          "shakeType": "shake-horizontal",
          "shakeDuration": 300,
          "hideUi": false
        },
        {
          "speaker": "center",
          "name": "Vergilius",
          "identity": "Guide",
          "text": "นั่งลง ดอน กิโฆเต้... เสียงของเธอทำให้เครื่องยนต์ส่งเสียงดังกว่าปกติ",
          "bg": 38,
          "bgm": 14,
          "sfx": null,
          "characters": [
            {
              "asset_id": 28,
              "position": "center",
              "highlight": true
            }
          ],
          "flash": false,
          "flashDuration": 400,
          "shake": false,
          "shakeType": "shake-horizontal",
          "shakeDuration": 300,
          "hideUi": false
        },
        {
          "speaker": "center",
          "name": "",
          "identity": "",
          "text": "ดอน กิโฆเต้ ทรุดตัวลงนั่งบนเบาะทันที เสียงเครื่องยนต์ของเมฟิสโตเฟเลสดังกระหึ่มขึ้นครืดหนึ่ง ก่อนจะกลับเข้าสู่จังหวะหมุนวนสม่ำเสมอท่ามกลางเงามืดที่ค่อยๆ คืบคลานเข้ามา",
          "bg": 38,
          "bgm": 14,
          "sfx": null,
          "characters": [],
          "flash": false,
          "flashDuration": 400,
          "shake": false,
          "shakeType": "shake-horizontal",
          "shakeDuration": 300,
          "hideUi": false
        }
      ],
      "nextChapter": 3,
